{
  "name": "@aftergame/game-core",
  "version": "0.1.0",
  "private": true,
  "description": "The game rules — pure, dependency-free, and exhaustively tested",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.5",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
