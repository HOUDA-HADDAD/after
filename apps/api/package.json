{
  "name": "@aftergame/api",
  "version": "0.1.0",
  "private": true,
  "description": "Aftergame API — Fastify HTTP, WebSocket and scheduled jobs",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed-cli.ts",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "test": "vitest run",
    "test:anonymity": "vitest run tests/anonymity",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage",
    "perf": "tsx scripts/perf-check.ts"
  },
  "dependencies": {
    "@aftergame/config": "workspace:*",
    "@aftergame/game-core": "workspace:^",
    "@aftergame/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2",
    "@prisma/client": "^6",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "autocannon": "^8.0.0",
    "embedded-postgres": "16.14.0-beta.17",
    "light-my-request": "^6.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
