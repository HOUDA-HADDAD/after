# Aftergame — environment configuration
#
# Copy to `.env` and adjust. Every variable is validated by packages/config at boot: the process
# refuses to start on a missing or malformed value rather than falling back to a silent default.
# Full reference: docs/09-deployment.md

# ---- Runtime ---------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Development only: the Vite dev server port. If you change it, change APP_ORIGIN to match —
# the dev server refuses to fall back to a random port, because a mismatched origin would make
# the CSRF check reject every write with a confusing 403.
WEB_PORT=5173

# Canonical public URL. Used as the CSRF Origin allowlist; must be https in production.
# In development this is the Vite dev server, which proxies /api to the API process.
APP_ORIGIN=http://localhost:5173

# ---- Database --------------------------------------------------------------------------------
# Pooled connection used by the application.
DATABASE_URL=postgresql://aftergame:aftergame@localhost:5432/aftergame
# Unpooled connection used only by `prisma migrate deploy`. Optional locally.
# DIRECT_DATABASE_URL=postgresql://aftergame:aftergame@localhost:5432/aftergame

# Tests only, and optional. Point it at a running PostgreSQL (docker compose creates
# `aftergame_test` for exactly this) to skip booting the embedded server on every run.
# Leave it unset and the integration suite starts its own PostgreSQL 16 — no Docker needed.
# TEST_DATABASE_URL=postgresql://aftergame:aftergame@localhost:5432/aftergame_test

# ---- Sessions --------------------------------------------------------------------------------
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Booting in production with this exact placeholder is refused.
SESSION_SECRET=replace-me-with-32-plus-random-bytes-base64
SESSION_TTL_DAYS=30

# ---- Game lifecycle --------------------------------------------------------------------------
# How long a finished timeline stays readable before it is hard-deleted (docs/00-spec-decisions.md D11).
SESSION_GRACE_HOURS=24
# Inactivity before a live game is abandoned.
SESSION_IDLE_TTL_MINUTES=180

# ---- Password hashing (OWASP minimums; raise without changing code) ---------------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- Limits ----------------------------------------------------------------------------------
MAX_GROUP_MEMBERS=50
MAX_SESSION_PLAYERS=30

# ---- Operations ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
# Where the built SPA lives, relative to the API process. Production only.
WEB_DIST_PATH=../web/dist
